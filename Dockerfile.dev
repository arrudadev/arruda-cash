# Dev-only image. Bind-mounted by docker-compose.yml for hot-reload;
# see there for how the app is actually run.
FROM node:24-slim

# Build toolchain for native modules (better-sqlite3, @libsql/sqlite3) in
# case no prebuilt binary matches this platform.
RUN apt-get update && apt-get install -y --no-install-recommends \
  python3 \
  make \
  g++ \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@11

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 3333 5173

CMD ["pnpm", "dev"]
