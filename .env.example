# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
MAIL_MAILER=smtp
MAIL_FROM_NAME="Naja Cash"
MAIL_FROM_ADDRESS=no-reply@naja.cash
SMTP_HOST=localhost
SMTP_PORT=1025
# Production email (Resend) — set these in your production environment instead
# MAIL_MAILER=resend
# RESEND_API_KEY=

# Database
# Leave DB_CONNECTION unset to use local SQLite (tmp/db.sqlite3). To use
# Turso instead, set DB_CONNECTION=turso and fill in the two vars below.
# DB_CONNECTION=turso
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=