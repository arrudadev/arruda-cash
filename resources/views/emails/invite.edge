<!DOCTYPE html>
<html>
<body style="margin:0; padding:0; background-color:#f5f5f5; font-family: system-ui, sans-serif;">
  <table role="presentation" width="100%" style="max-width:480px; margin:40px auto; background:#ffffff; border-radius:8px; overflow:hidden;">
    <tr>
      <td style="padding:32px;">
        <h1 style="font-size:20px; margin:0 0 16px;">You've been invited to Naja Cash</h1>
        <p style="font-size:15px; color:#444; line-height:1.5;">
          @if(fullName)
            Hi {{ fullName }},
          @else
            Hi,
          @endif
        </p>
        <p style="font-size:15px; color:#444; line-height:1.5;">
          Someone invited you to create an account. Click the button below to set your password
          and get started. This link expires in 72 hours and can only be used once.
        </p>
        <p style="margin:24px 0;">
          <a
            href="{{ acceptUrl }}"
            style="display:inline-block; background:#111; color:#fff; text-decoration:none; padding:10px 20px; border-radius:6px; font-weight:500;"
          >
            Accept invite
          </a>
        </p>
        <p style="font-size:13px; color:#888; line-height:1.5;">
          If the button doesn't work, copy and paste this link into your browser:<br />
          <a href="{{ acceptUrl }}" style="color:#888;">{{ acceptUrl }}</a>
        </p>
      </td>
    </tr>
  </table>
</body>
</html>
